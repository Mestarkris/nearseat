{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm run build -w web",
  "outputDirectory": "web/dist",
  "framework": null,
  "functions": { "api/index.mjs": { "maxDuration": 60 } },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api" }]
}
