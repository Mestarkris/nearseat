# Copy to .env and fill in. Never commit .env.
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org

# The account you created yourself (funded from the testnet faucet).
# The NearSeat contract is deployed ON this account, so vaults become
# seat-c5-12.<MASTER_ACCOUNT>. Keys are read from ~/.near-credentials/testnet/.
MASTER_ACCOUNT=nearseat.testnet

# Filled in by `npm run deploy` (sub-accounts of MASTER_ACCOUNT):
CONTRACT_ID=nearseat.testnet
TUSDC_ID=tusdc.nearseat.testnet
CLUB_ID=club.nearseat.testnet
GATE_ID=gate.nearseat.testnet
RELAYER_ID=relayer.nearseat.testnet

# Relayer
RELAYER_PORT=8787
RELAYER_ALLOWED_ORIGIN=http://localhost:5173

# Frontend (Vite exposes only VITE_* to the browser)
VITE_NETWORK=testnet
VITE_RPC_URL=https://rpc.testnet.near.org
VITE_CONTRACT_ID=nearseat.testnet
VITE_TUSDC_ID=tusdc.nearseat.testnet
VITE_CLUB_ID=club.nearseat.testnet
VITE_RELAYER_URL=http://localhost:8787
